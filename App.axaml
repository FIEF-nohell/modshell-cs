<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styling="using:FluentAvalonia.Styling"
             x:Class="modshell_hwtest.App"
             xmlns:local="using:modshell_hwtest"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <FontFamily x:Key="Mono">Cascadia Mono,Consolas,Courier New,monospace</FontFamily>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <styling:FluentAvaloniaTheme />
        <StyleInclude Source="/Controls/ControlStyles.axaml" />

        <Style Selector="ProgressBar.meter">
            <Setter Property="Height" Value="5" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="#211E29" />
            <Setter Property="Foreground" Value="#8B5CF6" />
            <!-- The Fluent default MinWidth (200) is wider than a squeezed star
                 column, which pushes the row grid into overflow and overlaps the
                 label. Meters must be free to shrink with their column. -->
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#6B677E" />
            <Setter Property="LetterSpacing" Value="2" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style Selector="TextBlock.rowLabel">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#8B87A0" />
        </Style>

        <Style Selector="TextBlock.rowValue">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#F2F0F8" />
        </Style>

        <Style Selector="TextBlock.headline">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#D8D5E6" />
        </Style>

        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#2A2636" />
            <Setter Property="Margin" Value="0,8" />
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#161420" />
            <Setter Property="BorderBrush" Value="#231F2E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="6" />
        </Style>

        <Style Selector="Ellipse.legendDot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
        </Style>
    </Application.Styles>
</Application>
