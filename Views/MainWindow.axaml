<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:modshell_hwtest.ViewModels"
        xmlns:views="using:modshell_hwtest.Views"
        xmlns:controls="using:modshell_hwtest.Controls"
        xmlns:models="using:modshell_hwtest.Models"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="820"
        x:Class="modshell_hwtest.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app-icon.ico"
        Title="modshell hwtest"
        Width="1000" Height="820"
        MinWidth="900" MinHeight="740"
        Background="#0D0C12"
        TransparencyLevelHint="Mica"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <views:MetricFormatConverter x:Key="Fmt" />
        <views:MetricPairFormatConverter x:Key="FmtPair" />
        <views:CoreColumnsConverter x:Key="CoreColumns" />
        <views:LoadHeatColorConverter x:Key="HeatColor" />
    </Window.Resources>

    <ScrollViewer Margin="18,42,18,18" VerticalScrollBarVisibility="Auto">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*,*">

        <!-- Row 0: headline vitals, all three share StatCard -->
        <controls:StatCard Grid.Row="0" Grid.Column="0" Title="CPU"
                           Detail="{Binding CurrentSnapshot.CpuName}">
            <UniformGrid Columns="2">
                <views:RadialGauge Caption="UTIL" Unit="%" HorizontalAlignment="Center"
                                   Value="{Binding CurrentSnapshot.CpuUsage}" />
                <views:RadialGauge Caption="TEMP" Unit="°C" HorizontalAlignment="Center"
                                   ShowDangerZone="True" WarnThreshold="75" DangerThreshold="90"
                                   Value="{Binding CurrentSnapshot.CpuTempC}" />
            </UniformGrid>
        </controls:StatCard>

        <controls:StatCard Grid.Row="0" Grid.Column="1" Title="MEMORY">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Classes="headline" Margin="0,0,0,8" TextTrimming="CharacterEllipsis">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource FmtPair}" ConverterParameter="Gigabytes">
                            <Binding Path="CurrentSnapshot.MemUsedGb" />
                            <Binding Path="CurrentSnapshot.MemTotalGb" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <lvc:CartesianChart Grid.Row="1" Series="{Binding MemorySeries}"
                                    XAxes="{Binding MemoryXAxes}" YAxes="{Binding MemoryYAxes}"
                                    MinHeight="96" TooltipPosition="Top" FindingStrategy="CompareOnlyX"
                                    TooltipBackgroundPaint="{Binding TooltipBackground}"
                                    TooltipTextPaint="{Binding TooltipText}" TooltipTextSize="12"
                                    LegendPosition="Hidden" />
            </Grid>
        </controls:StatCard>

        <controls:StatCard Grid.Row="0" Grid.Column="2" Title="GPU"
                           Detail="{Binding CurrentSnapshot.GpuName}">
            <UniformGrid Columns="2">
                <views:RadialGauge Caption="UTIL" Unit="%" HorizontalAlignment="Center"
                                   Value="{Binding CurrentSnapshot.GpuUsage}" />
                <views:RadialGauge Caption="TEMP" Unit="°C" HorizontalAlignment="Center"
                                   ShowDangerZone="True" WarnThreshold="75" DangerThreshold="90"
                                   Value="{Binding CurrentSnapshot.GpuTempC}" />
            </UniformGrid>
        </controls:StatCard>

        <!-- Row 1: per-core detail. Below the high-core-count threshold this is a
             label+bar+% list; above it (Threadripper/Xeon territory) that stops
             being legible so it switches to a compact color-coded tile grid. -->
        <Border Classes="panel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
            <StackPanel>
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Classes="sectionHeader" Text="CORES" />
                    <TextBlock Grid.Column="1" Classes="rowLabel" HorizontalAlignment="Right"
                               Text="{Binding CoreCount, StringFormat='{}{0} threads'}" />
                </Grid>

                <ItemsControl IsVisible="{Binding !IsHighCoreCount}" ItemsSource="{Binding PerCoreItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding CoreCount, Converter={StaticResource CoreColumns}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:CoreUsageItem">
                            <controls:MetricRow Margin="0,4,18,4"
                                                LabelMinWidth="30" ValueMinWidth="46"
                                                Label="{Binding Index, StringFormat='C{0}'}"
                                                Value="{Binding Value, Converter={StaticResource Fmt}, ConverterParameter=Percent}">
                                <ProgressBar Classes="meter" Minimum="0" Maximum="100" Value="{Binding Value}" />
                            </controls:MetricRow>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl IsVisible="{Binding IsHighCoreCount}" ItemsSource="{Binding PerCoreItems}" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:CoreUsageItem">
                            <Border Width="20" Height="20" Margin="2" CornerRadius="4"
                                    Background="{Binding Value, Converter={StaticResource HeatColor}}"
                                    ToolTip.Tip="{Binding Index, StringFormat='Core {0}'}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Row 2: GPU detail, network, ping -->
        <Border Classes="panel" Grid.Row="2" Grid.Column="0">
            <StackPanel>
                <TextBlock Classes="sectionHeader" Text="GPU DETAIL" />
                <controls:MetricRow Label="vram" LabelMinWidth="52" ValueMinWidth="122">
                    <controls:MetricRow.Value>
                        <MultiBinding Converter="{StaticResource FmtPair}" ConverterParameter="Megabytes">
                            <Binding Path="CurrentSnapshot.GpuVramUsedMb" />
                            <Binding Path="CurrentSnapshot.GpuVramTotalMb" />
                        </MultiBinding>
                    </controls:MetricRow.Value>
                    <ProgressBar Classes="meter" Minimum="0"
                                 Maximum="{Binding CurrentSnapshot.GpuVramTotalMb}"
                                 Value="{Binding CurrentSnapshot.GpuVramUsedMb}" />
                </controls:MetricRow>
                <controls:MetricRow Label="power" LabelMinWidth="52" ValueMinWidth="122"
                                    Value="{Binding CurrentSnapshot.GpuPowerWatts, Converter={StaticResource Fmt}, ConverterParameter=Watts}">
                    <ProgressBar Classes="meter" Minimum="0" Maximum="350"
                                 Value="{Binding CurrentSnapshot.GpuPowerWatts}" />
                </controls:MetricRow>
                <controls:MetricRow Label="temp" LabelMinWidth="52" ValueMinWidth="122"
                                    Value="{Binding CurrentSnapshot.GpuTempC, Converter={StaticResource Fmt}, ConverterParameter=Temperature}">
                    <ProgressBar Classes="meter" Minimum="0" Maximum="100"
                                 Value="{Binding CurrentSnapshot.GpuTempC}" />
                </controls:MetricRow>
            </StackPanel>
        </Border>

        <Border Classes="panel" Grid.Row="2" Grid.Column="1">
            <StackPanel>
                <TextBlock Classes="sectionHeader" Text="NETWORK" />
                <controls:MetricRow Label="down" LabelMinWidth="46" ValueMinWidth="90"
                                    Value="{Binding CurrentSnapshot.NetDownBytesPerSec, Converter={StaticResource Fmt}, ConverterParameter=BytesPerSecond}">
                    <lvc:CartesianChart Series="{Binding NetDownSeries}"
                                        XAxes="{Binding NetDownXAxes}" YAxes="{Binding NetDownYAxes}"
                                        Height="26" TooltipPosition="Hidden" LegendPosition="Hidden" />
                </controls:MetricRow>
                <controls:MetricRow Label="up" LabelMinWidth="46" ValueMinWidth="90"
                                    Value="{Binding CurrentSnapshot.NetUpBytesPerSec, Converter={StaticResource Fmt}, ConverterParameter=BytesPerSecond}">
                    <lvc:CartesianChart Series="{Binding NetUpSeries}"
                                        XAxes="{Binding NetUpXAxes}" YAxes="{Binding NetUpYAxes}"
                                        Height="26" TooltipPosition="Hidden" LegendPosition="Hidden" />
                </controls:MetricRow>
            </StackPanel>
        </Border>

        <!-- Ping. A single reading says almost nothing about a link, so the live
             value and sparkline sit above the distribution over the longer window. -->
        <Border Classes="panel" Grid.Row="2" Grid.Column="2">
            <StackPanel>
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Classes="sectionHeader" Text="{Binding PingHeader}" />
                    <TextBlock Grid.Column="1" Classes="rowLabel" HorizontalAlignment="Right"
                               Text="{Binding LatencyWindowLabel}" />
                </Grid>

                <controls:MetricRow Label="latency" LabelMinWidth="58" ValueMinWidth="70"
                                    Value="{Binding CurrentSnapshot.PingMs, Converter={StaticResource Fmt}, ConverterParameter=Milliseconds}">
                    <lvc:CartesianChart Series="{Binding PingSeries}"
                                        XAxes="{Binding PingXAxes}" YAxes="{Binding PingYAxes}"
                                        Height="26" TooltipPosition="Hidden" LegendPosition="Hidden" />
                </controls:MetricRow>

                <Border Classes="divider" />

                <UniformGrid Columns="2">
                    <controls:MetricRow Margin="0,3,10,3" LabelMinWidth="30" ValueMinWidth="56" Label="avg"
                                        Value="{Binding LatencyStats.Average, Converter={StaticResource Fmt}, ConverterParameter=MillisecondsFine}" />
                    <controls:MetricRow Margin="0,3,0,3" LabelMinWidth="30" ValueMinWidth="56" Label="jitter"
                                        Value="{Binding LatencyStats.Jitter, Converter={StaticResource Fmt}, ConverterParameter=MillisecondsFine}" />
                    <controls:MetricRow Margin="0,3,10,3" LabelMinWidth="30" ValueMinWidth="56" Label="p50"
                                        Value="{Binding LatencyStats.P50, Converter={StaticResource Fmt}, ConverterParameter=Milliseconds}" />
                    <controls:MetricRow Margin="0,3,0,3" LabelMinWidth="30" ValueMinWidth="56" Label="p95"
                                        Value="{Binding LatencyStats.P95, Converter={StaticResource Fmt}, ConverterParameter=Milliseconds}" />
                    <controls:MetricRow Margin="0,3,10,3" LabelMinWidth="30" ValueMinWidth="56" Label="p99"
                                        Value="{Binding LatencyStats.P99, Converter={StaticResource Fmt}, ConverterParameter=Milliseconds}" />
                    <controls:MetricRow Margin="0,3,0,3" LabelMinWidth="30" ValueMinWidth="56" Label="loss"
                                        Value="{Binding LatencyStats.LossPercent, Converter={StaticResource Fmt}, ConverterParameter=PercentFine}" />
                    <controls:MetricRow Margin="0,3,10,3" LabelMinWidth="30" ValueMinWidth="56" Label="min"
                                        Value="{Binding LatencyStats.Min, Converter={StaticResource Fmt}, ConverterParameter=Milliseconds}" />
                    <controls:MetricRow Margin="0,3,0,3" LabelMinWidth="30" ValueMinWidth="56" Label="max"
                                        Value="{Binding LatencyStats.Max, Converter={StaticResource Fmt}, ConverterParameter=Milliseconds}" />
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Row 3: utilization, cpu left / gpu right. -->
        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="*,*">
            <Border Classes="panel" Grid.Column="0">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                        <Ellipse Classes="legendDot" Fill="#8B5CF6" />
                        <TextBlock Classes="sectionHeader" Margin="0" Text="CPU UTILIZATION (60S)" />
                    </StackPanel>
                    <lvc:CartesianChart Grid.Row="1" Series="{Binding CpuUtilizationSeries}" XAxes="{Binding CpuUtilizationXAxes}"
                                        YAxes="{Binding CpuUtilizationYAxes}" MinHeight="130" Margin="0,10,0,0"
                                        TooltipPosition="Top" FindingStrategy="CompareOnlyX"
                                        TooltipBackgroundPaint="{Binding TooltipBackground}"
                                        TooltipTextPaint="{Binding TooltipText}" TooltipTextSize="12"
                                        LegendPosition="Hidden" />
                </Grid>
            </Border>

            <Border Classes="panel" Grid.Column="1">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                        <Ellipse Classes="legendDot" Fill="#22D3EE" />
                        <TextBlock Classes="sectionHeader" Margin="0" Text="GPU UTILIZATION (60S)" />
                    </StackPanel>
                    <lvc:CartesianChart Grid.Row="1" Series="{Binding GpuUtilizationSeries}" XAxes="{Binding GpuUtilizationXAxes}"
                                        YAxes="{Binding GpuUtilizationYAxes}" MinHeight="130" Margin="0,10,0,0"
                                        TooltipPosition="Top" FindingStrategy="CompareOnlyX"
                                        TooltipBackgroundPaint="{Binding TooltipBackground}"
                                        TooltipTextPaint="{Binding TooltipText}" TooltipTextSize="12"
                                        LegendPosition="Hidden" />
                </Grid>
            </Border>
        </Grid>

        <!-- Row 4: thermals, cpu left / gpu right. -->
        <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="*,*">
            <Border Classes="panel" Grid.Column="0">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                        <Ellipse Classes="legendDot" Fill="#8B5CF6" />
                        <TextBlock Classes="sectionHeader" Margin="0" Text="CPU THERMALS (60S)" />
                    </StackPanel>
                    <lvc:CartesianChart Grid.Row="1" Series="{Binding CpuThermalSeries}" XAxes="{Binding CpuThermalXAxes}"
                                        YAxes="{Binding CpuThermalYAxes}" MinHeight="130" Margin="0,10,0,0"
                                        TooltipPosition="Top" FindingStrategy="CompareOnlyX"
                                        TooltipBackgroundPaint="{Binding TooltipBackground}"
                                        TooltipTextPaint="{Binding TooltipText}" TooltipTextSize="12"
                                        LegendPosition="Hidden" />
                </Grid>
            </Border>

            <Border Classes="panel" Grid.Column="1">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                        <Ellipse Classes="legendDot" Fill="#22D3EE" />
                        <TextBlock Classes="sectionHeader" Margin="0" Text="GPU THERMALS (60S)" />
                    </StackPanel>
                    <lvc:CartesianChart Grid.Row="1" Series="{Binding GpuThermalSeries}" XAxes="{Binding GpuThermalXAxes}"
                                        YAxes="{Binding GpuThermalYAxes}" MinHeight="130" Margin="0,10,0,0"
                                        TooltipPosition="Top" FindingStrategy="CompareOnlyX"
                                        TooltipBackgroundPaint="{Binding TooltipBackground}"
                                        TooltipTextPaint="{Binding TooltipText}" TooltipTextSize="12"
                                        LegendPosition="Hidden" />
                </Grid>
            </Border>
        </Grid>

    </Grid>
    </ScrollViewer>

</Window>
