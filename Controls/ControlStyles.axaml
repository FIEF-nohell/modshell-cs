<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:modshell_hwtest.Controls"
        xmlns:conv="using:Avalonia.Data.Converters">

    <!-- One row layout for every label + bar/graph + value line in the app. -->
    <Style Selector="controls|MetricRow">
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*,Auto" ClipToBounds="True">
                    <TextBlock Grid.Column="0"
                               Text="{TemplateBinding Label}"
                               MinWidth="{TemplateBinding LabelMinWidth}"
                               FontFamily="{DynamicResource Mono}"
                               FontSize="12"
                               Foreground="#8B87A0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <ContentPresenter Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      Margin="10,0"
                                      MinWidth="0"
                                      ClipToBounds="True"
                                      VerticalAlignment="Center" />

                    <TextBlock Grid.Column="2"
                               Text="{TemplateBinding Value}"
                               MinWidth="{TemplateBinding ValueMinWidth}"
                               FontFamily="{DynamicResource Mono}"
                               FontSize="13"
                               Foreground="#F2F0F8"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- One card layout for the headline vitals row. -->
    <Style Selector="controls|StatCard">
        <Setter Property="Margin" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="#161420"
                        BorderBrush="#231F2E"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" ClipToBounds="True">
                            <TextBlock Text="{TemplateBinding Title}"
                                       FontFamily="{DynamicResource Mono}"
                                       FontSize="11"
                                       Foreground="#6B677E"
                                       LetterSpacing="2"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="·"
                                       IsVisible="{TemplateBinding Detail, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                       FontFamily="{DynamicResource Mono}"
                                       FontSize="11"
                                       Foreground="#4A4658"
                                       Margin="4,0,6,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Detail}"
                                       IsVisible="{TemplateBinding Detail, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                       FontFamily="{DynamicResource Mono}"
                                       FontSize="11"
                                       Foreground="#8B87A0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <ContentPresenter Grid.Row="1"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2"
                                   Text="{TemplateBinding Caption}"
                                   IsVisible="{TemplateBinding Caption, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                   FontFamily="{DynamicResource Mono}"
                                   FontSize="13"
                                   Foreground="#F2F0F8"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>
